# Absolute Linux path to the media folder on the Docker host.
MEDIA_HOST_PATH=/srv/media

# Used with docker-compose.hub.yml after the image is published.
DOCKER_IMAGE=kangtong1993/h264-timestamp-repair:2.2.1

TZ=Asia/Shanghai
# Optional filename filter. Leave empty to scan every MP4 file.
NAME_CONTAINS=

# true: repair confirmed candidates and overwrite after validation.
# false: scan/report only.
AUTO_REPAIR=false
# Strictly remove only one untitled chapter that spans the complete file.
REPAIR_EMPTY_FULL_CHAPTERS=true

# Optional Emby refresh after a repair. Prefer a mounted secret file over EMBY_API_KEY.
EMBY_URL=
EMBY_MEDIA_ROOT=
EMBY_API_KEY_FILE=
EMBY_REFRESH_RETRY_SECONDS=60
EMBY_REFRESH_MAX_RETRY_SECONDS=21600

# Changed files are processed after a 60-second quiet period and the minimum age.
# A metadata-only reconciliation runs once per day at the configured local time.
MIN_FILE_AGE_SECONDS=3600
FILE_SETTLE_SECONDS=60
RECONCILE_LOCAL_TIME=04:00
EVENT_HISTORY_LIMIT=5000

SAMPLE_SECONDS=8
MINIMUM_PACKETS=60
RETRY_FAILED_AFTER_SECONDS=86400
KEEP_TEMP_ON_FAILURE=false

# Anonymous read-only Web dashboard. Keep this port on a trusted LAN only.
WEB_UI_ENABLED=true
WEB_UI_BIND_ADDRESS=0.0.0.0
WEB_UI_HOST_PORT=8080
WEB_SHOW_FULL_PATHS=false
