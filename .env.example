# Absolute Linux path to the media folder on the Docker host.
MEDIA_HOST_PATH=/srv/media

# Used with docker-compose.hub.yml after the image is published.
DOCKER_IMAGE=kangtong1993/h264-timestamp-repair:1.1.0

TZ=Asia/Shanghai
# Optional filename filter. Leave empty to scan every MP4 file.
NAME_CONTAINS=

# true: repair confirmed candidates and overwrite after validation.
# false: scan/report only.
AUTO_REPAIR=false

# Scan every 30 minutes. New files must be at least 60 minutes old so that a
# file still being copied/downloaded is not touched.
SCAN_INTERVAL_SECONDS=1800
MIN_FILE_AGE_SECONDS=3600
STABLE_SCANS=1

SAMPLE_SECONDS=8
MINIMUM_PACKETS=60
RETRY_FAILED_AFTER_SECONDS=86400
KEEP_TEMP_ON_FAILURE=false

# Read-only Web dashboard. If WEB_PASSWORD is empty, a random password is
# generated at config/web-password.txt on first start.
WEB_UI_ENABLED=true
WEB_UI_BIND_ADDRESS=0.0.0.0
WEB_UI_HOST_PORT=8080
WEB_USERNAME=admin
WEB_PASSWORD=
WEB_SHOW_FULL_PATHS=false
